{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Development Dependencies",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "pip",
        "install",
        "--group",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$python"
    },
    {
      "label": "Create Package",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "build",
        "--wheel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$python",
      "dependsOn": "Install Development Dependencies"
    },
    {
      "label": "Install Package",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "pip",
        "install",
        ".",
        "--group",
        "dev",
        "--force-reinstall"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$python"
    },
    {
      "label": "Run Test",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "pytest",
        "-s"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$python"
    },
    {
      "label": "Clean venv",
      "type": "shell",
      "command": ".venv\\Scripts\\pip.exe uninstall -y SilKit_py",
      "group": "none",
      "problemMatcher": "$python"
    }
  ]
}
